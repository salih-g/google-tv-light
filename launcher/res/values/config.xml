<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher settings. Edit, then run launcher/build.sh and tvclean.py install.
  Package names on the TV: .venv/bin/python -I tvclean.py shell 'pm list packages'
-->
<resources>
    <!-- Dock apps, left to right. Apps that aren't installed are skipped. -->
    <string-array name="dock_apps">
        <item>com.netflix.ninja</item>
        <item>com.google.android.youtube.tv</item>
        <item>com.disney.disneyplus</item>
        <item>com.wbd.stream</item>
        <item>com.apple.atve.androidtv.appletv</item>
        <item>com.turkcell.ott</item>
        <item>com.kick.mobile</item>
    </string-array>

    <!-- Never shown as tiles: TV helpers that live in the Inputs menu. -->
    <string-array name="hidden_apps">
        <item>com.tcl.tv</item>
        <item>com.tcl.suspension</item>
        <item>com.tcl.t_solo</item>
        <item>com.tcl.dashboard</item>
        <item>dev.salih.tvhome</item>
    </string-array>

    <!-- The TV's Live TV / tuner app, listed first in the Inputs menu. -->
    <string name="live_tv_package" translatable="false">com.tcl.tv</string>

    <!-- The manufacturer's own source picker, used if switching to an input directly fails. -->
    <string name="input_picker_package" translatable="false">com.tcl.suspension</string>

    <!-- Remote app buttons: "keycode|package", or "keycode|@apps" for the all-apps grid.
         Codes are the TV's own (see the key log: tvclean.py shell 'logcat -s TclPhoneWindowManager').
         4062 Netflix, 4065 YouTube, 4099 Prime Video, 4141 Disney+, 4160 Apple TV, 4020 the T key,
         4140 the key TCL assigns to Safety Guard (removed here, so it opens Nuvio instead). -->
    <string-array name="app_keys" translatable="false">
        <item>4062|com.netflix.ninja</item>
        <item>4065|com.google.android.youtube.tv</item>
        <item>4099|com.amazon.amazonvideo.livingroom</item>
        <item>4141|com.disney.disneyplus</item>
        <item>4160|com.apple.atve.androidtv.appletv</item>
        <item>4020|@apps</item>
        <item>4140|com.nuvio.tv</item>
    </string-array>

    <!-- Tiles per row in the all-apps grid. -->
    <integer name="columns">5</integer>

    <!-- Minutes between wallpaper scene changes. -->
    <integer name="wallpaper_minutes">30</integer>

    <!-- Name used in the greeting ("Good evening, Salih"). Leave empty for no name. -->
    <string name="owner_name" translatable="false"></string>
</resources>
